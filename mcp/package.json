{
  "name": "arc-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for Arc blockchain — USDC balance, transfer, and smart-contract tools for AI agents",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "node --loader ts-node/esm src/server.ts",
    "stdio": "MCP_TRANSPORT=stdio node --loader ts-node/esm src/server.ts",
    "http": "MCP_TRANSPORT=http node --loader ts-node/esm src/server.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@circle-fin/developer-controlled-wallets": "^6.0.0",
    "viem": "^2.17.0",
    "zod": "^3.23.8",
    "express": "^4.21.0",
    "uuid": "^10.0.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/uuid": "^10.0.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.5.4",
    "ts-node": "^10.9.2"
  }
}
